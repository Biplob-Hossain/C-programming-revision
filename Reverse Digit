#include<stdio.h>

int main()
{
     int N, temp, rem, reverse=0;

     printf("ENter any Digit for sum\n");

    scanf("%d",&N);

    temp=N;
    while (temp!=0)
    {
        rem=temp%10;
        reverse=reverse*10+rem;
        temp=temp/10;
    }
    printf(" After reverse  Digit is %d ",reverse);
    return 0;
    

}
